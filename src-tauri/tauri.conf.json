{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "墨屿写作",
  "version": "1.0.0",
  "identifier": "com.inkwell.moyu",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "墨屿写作",
        "width": 1120,
        "height": 780,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}